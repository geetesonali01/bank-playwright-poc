{
  "name": "bank-playwright-poc",
  "version": "1.0.0",
  "description": "Playwright + TypeScript automation POC on the ParaBank demo banking app",
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:headed": "playwright test --project=chromium --headed",
    "test:ui": "playwright test --ui",
    "test:content": "playwright test tests/content",
    "test:transaction": "playwright test tests/transaction --project=chromium",
    "test:api": "playwright test tests/api --project=chromium",
    "report": "playwright show-report"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
